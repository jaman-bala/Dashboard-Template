# Environment mode (PROD, DEV, test)
MODE=DEV

# App
PROJECT_NAME=Dashboard Template
PROJECT_VERSION=1.0.0

# Database (Docker)
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_USER=dashboard
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=dashboard_db

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# JWT (generate a strong secret: openssl rand -base64 64)
JWT_SECRET_KEY=your_jwt_secret_key_min_32_chars_here_change_me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# Validation patterns
PASSWORD_REGEX_PATTERN=^(?=.*[A-Z])(?=.*[0-9])(?=.*[a-z]).*$
PHONE_REGEX_PATTERN=^\+?\d{5,20}$

# Static files paths
LINK_IMAGES=src/static/avatars/
LINK_UPLOAD_FILES=src/static/upload-files/
LINK_UPLOAD_PHOTO=src/static/photo/

# MinIO (S3-compatible storage)
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=your_minio_secret_key_here
MINIO_BUCKET_NAME=avatars
MINIO_SECURE=false
MINIO_PUBLIC_URL=http://localhost:9000
